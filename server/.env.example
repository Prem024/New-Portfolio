# Server port (avoid 5000 on macOS because AirPlay Receiver uses it)
PORT=5005

# PostgreSQL / Supabase / Neon connection string
# Example local: postgresql://postgres:postgres@localhost:5432/portfolio_messages
# Example Neon/Supabase: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_messages

# Allowed frontend origins (comma-separated)
CLIENT_ORIGIN=http://localhost:3000

# Admin login credentials for /messages and /admin
ADMIN_EMAIL=premnanda532@gmail.com
# Use either ADMIN_PASSWORD (for quick setup) or a bcrypt hash in ADMIN_PASSWORD_HASH
ADMIN_PASSWORD=6353634488
# ADMIN_PASSWORD_HASH=

# Secret key for signing JWT auth cookies/tokens (use a long random string in production)
JWT_SECRET=replace-with-a-long-random-secret-key
